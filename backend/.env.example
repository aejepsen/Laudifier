# Laudifier Backend — variáveis de ambiente
# Copie para `.env` e preencha. Nunca commite `.env`.

# ── Ambiente ─────────────────────────────────────────────────────────────────
APP_ENV=development                    # development | production
CORS_ORIGINS=http://localhost:4200     # lista separada por vírgula

# ── Anthropic (Claude) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6      # opcional; default claude-sonnet-4-6

# ── Supabase (auth + banco) ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# JWT secret (HS256) — usado para validar tokens do Supabase localmente
JWT_SECRET=<supabase-jwt-secret>

# ── Qdrant (vetor RAG) ───────────────────────────────────────────────────────
QDRANT_URL=https://<cluster>.qdrant.io   # ou http://localhost:6333 local
QDRANT_API_KEY=<apenas-em-cloud>
QDRANT_COLLECTION=laudos_medicos

# ── Mem0 Cloud (memória persistente) ─────────────────────────────────────────
MEM0_API_KEY=mem0-...

# ── Langfuse (observability) ─────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Storage ──────────────────────────────────────────────────────────────────
USE_LOCAL_STORAGE=true                 # false → usa Azure Blob
LOCAL_STORAGE_PATH=./storage
AZURE_STORAGE_CONNECTION_STRING=<DefaultEndpointsProtocol=...>

# ── Whisper (transcrição server-side, fallback) ──────────────────────────────
WHISPER_MODEL=small                    # tiny | base | small | medium
WHISPER_CACHE_DIR=/home/app/.cache/whisper

# ── Observability knobs ──────────────────────────────────────────────────────
QUERY_COUNT_THRESHOLD=10               # warn quando request dispara > N queries externas
